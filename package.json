{
  "name": "game-starter-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"pnpm:dev:server\" \"pnpm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test shared/*.test.ts server/*.test.ts",
    "build:solo": "tsx scripts/build-solo.ts",
    "tunnel": "pnpm build && tsx scripts/tunnel.ts",
    "test:e2e": "pnpm build && tsx --test e2e/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:ai": "tsx scripts/check-ai-traces.ts",
    "prepare": "node -e \"try{require('node:child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "uqr": "0.1.3",
    "valibot": "1.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
